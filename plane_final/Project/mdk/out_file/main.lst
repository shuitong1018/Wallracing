  278          void speed_calculate(){
  279   1        
  280   1                  float eL = (float)(target_speed_L - left_encoder_data*0.003518);   // µ±Ç°Îó²î£¨×ó£©
  281   1                  float eR = (float)(target_speed_R - right_encoder_data*0.003518);  // µ±Ç°Îó²î£¨ÓÒ£©
  282   1      
  283   1                  float ff_L = target_speed_L * KF_L;
  284   1                  float ff_R = target_speed_R * KF_R;
  285   1        
  286   1                  // 3. Î»ÖÃÊ½ PD ¹«Ê½
  287   1                  duty_L = Kp_L * eL + Kd_L * (eL - prev_e_L) + ff_L;
  288   1                  duty_R = Kp_R * eR + Kd_R * (eR - prev_e_R) + ff_R;
  289   1      
  290   1                  // È«¾ÖÏÞ·ù
  291   1                  if (duty_L > MAX_DUTY)  duty_L = MAX_DUTY;
  292   1                  if (duty_L < -MAX_DUTY) duty_L = -MAX_DUTY;
  293   1                  if (duty_R > MAX_DUTY)  duty_R = MAX_DUTY;
  294   1                  if (duty_R < -MAX_DUTY) duty_R = -MAX_DUTY;
  295   1      
  296   1                  // ¸üÐÂÀúÊ·¼ÇÂ¼
  297   1                  prev_e_L = eL;
  298   1                  prev_e_R = eR;
  299   1      }
