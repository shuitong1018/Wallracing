  101   1          L1_norm = (float)Normalize_ADC((int16)raw1, L1_MAX, L1_MIN);
  102   1          L2_norm = (float)Normalize_ADC((int16)raw2, L2_MAX, L2_MIN);
  103   1          L3_norm = (float)Normalize_ADC((int16)raw3, L3_MAX, L3_MIN);
  104   1          L4_norm = (float)Normalize_ADC((int16)raw4, L4_MAX, L4_MIN);
