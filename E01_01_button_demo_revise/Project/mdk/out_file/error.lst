   88          // ================== 6. 核心算法：计算赛道偏差 ==================
   89          float Error_Calculate(float l1_n, float l2_n, float l3_n, float l4_n) {
   90   1          float numerator;             // 公式分子
   91   1          float denominator;           // 公式分母
   92   1          float raw_error;             // 原始误差
   93   1          float L1, L2, L3, L4;        // 比例化后的电感值
   94   1          
   95   1          // 【关键对接步】：将 sensor.c 传过来的 0~128 的整数范围，等比例压缩到 0.0~1.0 的小数区间
   96   1          // 这是差比和算法的数学基础，保证各个电感的权重统一
   97   1          L1 = l1_n / 128.0f;
   98   1          L2 = l2_n / 128.0f;
   99   1          L3 = l3_n / 128.0f;
  100   1          L4 = l4_n / 128.0f;
  101   1      
  102   1          // 根据官方公式计算分子：A*(L1-L4) + B*(L2-L3)
  103   1          numerator = COEFF_A * (L1 - L4) + COEFF_B * (L2 - L3);
  104   1          
  105   1          // 根据官方公式计算分母：A*(L1+L4) + C*|L2-L3|
  106   1          denominator = COEFF_A * (L1 + L4) + COEFF_C * my_abs(L2 - L3);
  107   1          
  108   1          // 除零保护：如果车飞出赛道，电感全为0，分母极小，防止引发单片机硬件除零异常导致死机重启
  109   1          if(denominator < 0.001f) {
  110   2              raw_error = 0.0f; // 丢失赛道时，可以根据实际情况改为输出上一帧的误差 (或者保持直行)
  111   2          } else {
  112   2              // 算出原始偏差，并放大100倍，方便后续 PID 整数计算和观察
  113   2              raw_error = (numerator * 100.0f) / denominator;
  114   2          }
  115   1          
  116   1          // 绝对安全限幅：防止偏差过大导致舵机打死卡住齿轮
  117   1          if(raw_error > ERROR_MAX) {
  118   2              raw_error = ERROR_MAX;
  119   2          }
  120   1          if(raw_error < ERROR_MIN) {
  121   2              raw_error = ERROR_MIN;
  122   2          }
  123   1          
