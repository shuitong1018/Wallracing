   30          // ================== 5. 去极值平均滤波算法 ==================
   31          static float remove_extremes_average_filter(float new_value) {
   32   1          unsigned char i;
   33   1          float sum;
   34   1          float max_value, min_value;
   35   1          unsigned char valid_count;
   36   1          
   37   1          // 将新算出的误差存入环形缓冲区
   38   1          error_buffer[buffer_index] = new_value;
   39   1          buffer_index++;
   40   1          
   41   1          // 缓冲区游标循环
   42   1          if(buffer_index >= FILTER_WINDOW_SIZE) {
   43   2              buffer_index = 0;
   44   2              buffer_full = 1;  
   45   2          }
   46   1          
