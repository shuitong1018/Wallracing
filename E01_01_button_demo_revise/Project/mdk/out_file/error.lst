   49   2              valid_count = FILTER_WINDOW_SIZE;
   50   2          } else {
   51   2              valid_count = buffer_index;
   52   2          }
   53   1          
   54   1          // 刚开机数据不足3个时，无法去极值，直接算普通平均
   55   1          if(valid_count < 3) {
   56   2              sum = 0.0f;
   57   2              for(i = 0; i < valid_count; i++) {
