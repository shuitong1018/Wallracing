  158          PathType_t Path_Detect(float L1, float L2, float L3, float L4)
  159          {
  160              PathType_t detected = PATH_STRAIGHT;  // 默认直道
  161              float error = Error_Calculate(L1, L2, L3, L4);
  162              
  163              // 1. 检测是否丢线（所有电感信号都很弱）
  164              if(detect_lost_line(L1, L2, L3, L4)) {
  165                  controller.lost_line_counter++;
  166                  
  167                  // 在特殊路况中丢线是正常的，需要结合历史状态判断
  168                  if(controller.current_path == PATH_LEFT_ANGLE || 
  169                     controller.current_path == PATH_RIGHT_ANGLE ||
  170                     controller.current_path == PATH_ROUNDABOUT) {
  171                      // 过弯或环岛时丢线正常，保持状态
  172                      detected = controller.current_path;
  173                      update_history(L1, L2, L3, L4, error, detected);
  174                      return detected;
  175                  }
  176                  
  177                  // 短暂丢线可能只是晃动
  178                  if(controller.lost_line_counter < 5) {
  179                      detected = controller.current_path;
  180                  } else {
  181                      detected = PATH_FLAT;
  182                  }
  183                  
  184                  update_history(L1, L2, L3, L4, error, detected);
  185                  return detected;
  186              } else {
  187                  controller.lost_line_counter = 0;
  188              }
  189              
