  250          static int detect_lost_line(float L1, float L2, float L3, float L4)
  251          {
  252              return (L1 < THRESHOLD_LOST_LINE && L2 < THRESHOLD_LOST_LINE && 
  253                      L3 < THRESHOLD_LOST_LINE && L4 < THRESHOLD_LOST_LINE);
