  584                      
  585                      // 环岛内循迹
  586                      if(controller.roundabout_phase == 0) {
  587                          // 入口阶段：根据进入方向转向
  588                          if(controller.left_bias_count > controller.right_bias_count) {
  589                              action = ACTION_TURN_LEFT_SMOOTH;
  590                          } else {
  591                              action = ACTION_TURN_RIGHT_SMOOTH;
  592                          }
  593                          
  594                          // 进入环岛后切换状态
  595                          if(my_abs(error) > ERROR_CIRCLE_THRESHOLD * 1.5f) {
  596                              controller.roundabout_phase = 1;  // 进入岛内
  597                          }
  598                      } else if(controller.roundabout_phase == 1) {
  599                          // 岛内阶段：稳定循迹
  600                          if(direction < 0) {
  601                              action = ACTION_TURN_LEFT_SMOOTH;
  602                          } else if(direction > 0) {
  603                              action = ACTION_TURN_RIGHT_SMOOTH;
  604                          } else {
  605                              action = ACTION_TRACKING;
  606                          }
  607                          
  608                          // 检测环岛边沿（丢线计数）
  609                          if(detect_lost_line(L1, L2, L3, L4)) {
  610                              controller.roundabout_edge_count++;
  611                          }
  612                      }
  613                      
  614                      // 环岛出口检测
  615                      if(controller.roundabout_edge_count >= ROUNDABOUT_EDGE_MAX) {
  616                          // 准备出环岛
  617                          controller.roundabout_phase = 2;
  618                          action = ACTION_FORWARD_STRAIGHT;
  619                          
  620                          // 完全退出环岛
  621                          if(my_abs(error) < ERROR_STRAIGHT_THRESHOLD) {
  622                              controller.in_roundabout = 0;
  623                              controller.roundabout_phase = 0;
  624                              controller.roundabout_edge_count = 0;
  625                          }
  626                      }
  627                      break;
  628                      
  629                  case PATH_FLAT:
  630                      // 平地/丢线：紧急处理
  631                      controller.lost_line_counter++;
  632                      if(controller.lost_line_counter < 10) {
  633                          // 短暂丢线，使用上次有效误差进行循迹
  634                          action = ACTION_TRACKING;
  635                      } else {
  636                          // 长时间丢线，停止
  637                          action = ACTION_STOP;
  638                      }
  639                      break;
