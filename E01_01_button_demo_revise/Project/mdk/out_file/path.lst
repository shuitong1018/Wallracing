  543                          action = ACTION_TURN_LEFT_SMOOTH;
  544                      } else if(error > ERROR_CIRCLE_THRESHOLD) {
  545                          action = ACTION_TURN_RIGHT_SMOOTH;
  546                      } else {
  547                          action = ACTION_TRACKING;
  548                      }
  549                      break;
  550                      
  551                  case PATH_CROSSROAD:
  552                      // 十字路口：保持直行
