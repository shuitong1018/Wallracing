  256          //==============================================================================
  257          // 检测十字路口
  258          //==============================================================================
  259          static int detect_crossroad(float L1, float L2, float L3, float L4)
  260          {
  261              // 十字路口特征：四个电感都有较强信号，且中间两个电感信号强于两边
  262              float middle_avg = (L2 + L3) / 2.0f;
  263              float side_avg = (L1 + L4) / 2.0f;
  264              
  265              return (L1 > THRESHOLD_STRONG_SIGNAL && 
  266                      L2 > THRESHOLD_STRONG_SIGNAL && 
  267                      L3 > THRESHOLD_STRONG_SIGNAL && 
  268                      L4 > THRESHOLD_STRONG_SIGNAL &&
  269                      middle_avg > side_avg * 1.2f);
  270          }
  271          
  272          //==============================================================================
  273          // 检测直角弯
  274          //==============================================================================
  275          static int detect_angle(float L1, float L2, float L3, float L4)
  276          {
  277              // 直角弯特征：某一侧电感信号很强，另一侧很弱
  278              float left_sum = L1 + L2;
  279              float right_sum = L3 + L4;
  280              float side_diff = my_abs(left_sum - right_sum);
  281              
  282              // 左右差异大，且单侧信号强
  283              if(side_diff > THRESHOLD_SIDE_DIFF * 2) {
  284                  if((L1 > THRESHOLD_STRONG_SIGNAL && L4 < THRESHOLD_WEAK_SIGNAL) ||
  285                     (L4 > THRESHOLD_STRONG_SIGNAL && L1 < THRESHOLD_WEAK_SIGNAL)) {
  286                      return 1;
  287                  }
  288              }
  289              
  290              return 0;
  291          }
  292          
  293          //==============================================================================
  294          // 检测圆形弯道
  295          //==============================================================================
  296          static int detect_circular(float L1, float L2, float L3, float L4, float error)
  297          {
  298              // 圆形弯道特征：持续的较大误差，且误差方向稳定
  299              static int same_direction_count = 0;
  300              static float last_error_direction = 0;
  301              
  302              float current_direction = (error > 0) ? 1 : ((error < 0) ? -1 : 0);
  303              
  304              // 误差足够大且方向一致
  305              if(my_abs(error) > ERROR_CIRCLE_THRESHOLD) {
  306                  if(current_direction == last_error_direction) {
  307                      same_direction_count++;
  308                  } else {
  309                      same_direction_count = 1;
  310                  }
  311              } else {
  312                  same_direction_count = 0;
  313              }
  314              
  315              last_error_direction = current_direction;
  316              
  317              return (same_direction_count > CIRCLE_COUNT_THRESHOLD);
  318          }
  319          
  320          //==============================================================================
  321          // 检测折线
C251 COMPILER V5.60.0,  path                                                               01/04/26  15:39:55  PAGE 6   

  322          //==============================================================================
  323          static int detect_zigzag(float L1, float L2, float L3, float L4, float error)
  324          {
  325              // 折线特征：误差快速变化
  326              static float last_error = 0;
  327              static int change_count = 0;
  328              
  329              float error_change = my_abs(error - last_error);
  330              
  331              if(error_change > 50.0f) {  // 误差变化大
  332                  change_count++;
  333                  if(change_count > 3) {
  334                      change_count = 0;
  335                      last_error = error;
  336                      return 1;
  337                  }
  338              } else {
  339                  change_count = 0;
  340              }
  341              
  342              last_error = error;
  343              return 0;
  344          }
  345          
  346          //==============================================================================
  347          // 检测环岛
  348          //==============================================================================
  349          static int detect_roundabout(float L1, float L2, float L3, float L4)
  350          {
  351              // 环岛特征：长时间的单侧偏置
  352              int direction = get_bias_direction(L1, L2, L3, L4);
  353              
  354              if(direction < 0) {  // 左偏
  355                  controller.left_bias_count++;
  356                  controller.right_bias_count = 0;
  357              } else if(direction > 0) {  // 右偏
  358                  controller.right_bias_count++;
  359                  controller.left_bias_count = 0;
  360              } else {
  361                  // 短暂回中不立即清零
  362                  if(controller.left_bias_count > 0) {
  363                      controller.left_bias_count = controller.left_bias_count > 2 ? controller.left_bias_count - 1 
             -: 0;
  364                  }
  365                  if(controller.right_bias_count > 0) {
  366                      controller.right_bias_count = controller.right_bias_count > 2 ? controller.right_bias_count -
             - 1 : 0;
  367                  }
  368              }
  369              
  370              // 连续多次同向偏置，可能是环岛
  371              if(controller.left_bias_count > 8 || controller.right_bias_count > 8) {
  372                  return 1;
  373              }
  374              
  375              return 0;
  376          }
