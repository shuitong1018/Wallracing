  385              
C251 COMPILER V5.60.0,  path                                                               01/04/26  15:39:55  PAGE 7   

  386              if(left_strength > right_strength + THRESHOLD_SIDE_DIFF) {
  387                  return -1;  // 左偏
  388              } else if(right_strength > left_strength + THRESHOLD_SIDE_DIFF) {
  389                  return 1;   // 右偏
  390              } else {
  391                  return 0;   // 居中
  392              }
