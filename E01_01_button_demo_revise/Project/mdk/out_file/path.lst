  559                      }
  560                      break;
  561                      
  562                  case PATH_ZIGZAG:
  563                      // 折线：快速响应
  564                      if(my_abs(error) > ERROR_CIRCLE_THRESHOLD * 1.5f) {
  565                          if(error < 0) {
  566                              action = ACTION_TURN_LEFT_HARD;
  567                          } else {
  568                              action = ACTION_TURN_RIGHT_HARD;
  569                          }
  570                      } else {
  571                          action = ACTION_TRACKING_FAST;
  572                      }
  573                      break;
  574                      
  575                  case PATH_ROUNDABOUT:
  576                      // 环岛处理
  577                      if(!controller.in_roundabout) {
  578                          // 首次进入环岛
  579                          controller.in_roundabout = 1;
  580                          controller.roundabout_phase = 0;  // 入口
  581                          controller.roundabout_edge_count = 0;
  582                          controller.roundabout_entry_error = error;
  583                      }
