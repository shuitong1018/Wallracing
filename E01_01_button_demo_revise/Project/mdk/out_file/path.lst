  395          //==============================================================================
  396          // 更新传感器历史
  397          //==============================================================================
  398          static void update_history(float L1, float L2, float L3, float L4, float error, PathType_t type)
  399          {
  400              controller.history_index = (controller.history_index + 1) % HISTORY_DEPTH;
  401              
  402              controller.history[controller.history_index].values[0] = L1;
  403              controller.history[controller.history_index].values[1] = L2;
  404              controller.history[controller.history_index].values[2] = L3;
  405              controller.history[controller.history_index].values[3] = L4;
  406              controller.history[controller.history_index].error = error;
  407              controller.history[controller.history_index].detected_type = type;
  408              controller.history[controller.history_index].timestamp = systick_get_ms();
  409          }
  410          
  411          //==============================================================================
  412          // 获取稳定的路径类型
  413          //==============================================================================
  414          static PathType_t get_stable_path_type(void)
  415          {
  416              int count[PATH_TYPE_COUNT] = {0};
  417              int max_count = 0;
  418              PathType_t stable_type = PATH_STRAIGHT;
  419              
  420              // 统计历史数据
  421              for(int i = 0; i < HISTORY_DEPTH; i++) {
  422                  PathType_t type = controller.history[i].detected_type;
  423                  if(type < PATH_TYPE_COUNT) {
  424                      count[type]++;
  425                  }
  426              }
  427              
  428              // 找出现次数最多的类型
  429              for(int i = 0; i < PATH_TYPE_COUNT; i++) {
  430                  if(count[i] > max_count) {
  431                      max_count = count[i];
  432                      stable_type = (PathType_t)i;
  433                  }
  434              }
  435              
  436              // 需要达到一定置信度，否则保持当前路径
  437              if(max_count < HISTORY_DEPTH / 2) {
  438                  return controller.current_path;
  439              }
  440              
  441              return stable_type;
  442          }
