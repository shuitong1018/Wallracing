  190          void dir_get(){
  191   1          // ¶ÁÈ¡´«¸ÐÆ÷
  192   1          Sensor_Read_Normalized();
  193   1          //Sensor_Monitor();
  194   1        
  195   1          // ¼ÆËãÎó²î
  196   1          error_value = Error_Calculate(L1_norm, L2_norm, L3_norm, L4_norm);
  197   1      }
  198          
  199          void dir_calculate(){
  200   1          float e = error_value;
  201   1          float abs_e = (e>=0) ? e : -e;
  202   1      
  203   1          dir_output = Kp1_dir * e + Kp2_dir * e * abs_e + Kd_dir * (e - prev_e_dir);
  204   1          
  205   1          // ÏÞ·ù¿ØÖÆÁ¿
  206   1          if (dir_output > 0.6f) dir_output = 0.6f;
  207   1          if (dir_output < -0.6f) dir_output = -0.6f;
  208   1          
  209   1          prev_e_dir = e;
  210   1      }
  211          
  212          void dir_control(){
  213   1          dir_get();
  214   1          dir_calculate();
  215   1      }
  216          
  217          void patrol_line(){
  218   1          dir_control();
  219   1          target_speed_L = target_speed - dir_output; // ½«·½Ïò¿ØÖÆÊä³öµþ¼Óµ½×óÂÖÕ¼¿Õ±È
  220   1          target_speed_R = target_speed + dir_output; // ½«·½Ïò¿ØÖÆÊä³öµþ¼Óµ½ÓÒÂÖÕ¼¿Õ±È
  221   1          if(target_speed_L < 0.02) target_speed_L = 0.02;
  222   1          if(target_speed_R < 0.02) target_speed_R = 0.02;
  223   1          speed_control();
  224   1          
  225   1      }
