   50          // ================= 2. 核心归一化算法 =================
   51          // 严格遵守官方公式：将ADC值映射到 0-128 范围的高效整型运算
   52          int16 Normalize_ADC(int16 value, int16 Max, int16 Min)
   53          {
   54   1          int16 buf;
   55   1          
   56   1          // 容错：如果宏定义填反了大小值，自动交换
   57   1          if (Min > Max) {
C251 COMPILER V5.60.0,  sensor                                                             10/07/26  20:30:21  PAGE 2   

   58   2              buf = Min;
   59   2              Min = Max;
   60   2              Max = buf;
   61   2          }
   62   1          
   63   1          // 限幅保护：防止跑出边界导致负数或者超过128（这是防止车子一碰线就满偏锁死的关键）
   64   1          if (value <= Min) return 0;
   65   1          if (value >= Max) return 128;
   66   1          
   67   1          // 核心公式：利用左移7位 (<< 7) 代替乘以128，极大提升单片机运算速度，避免浮点灾难
   68   1          return ((value - Min) << 7) / (Max - Min);
   69   1      }
