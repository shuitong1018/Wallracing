  499          void speed_calculate(void) {
  500   1          // 1. ÑÏ¸ñ×ñÊØ C89£º¼¯ÖÐÉùÃ÷ËùÓÐÁÙÊ±±äÁ¿
  501   1          float eL, eR, ff_L, ff_R;
  502   1      
  503   1          // 2. È»ºóÔÙ½øÐÐ¼ÆËã (´øÉÏ 'f' ºó×º£¬·ÀÖ¹±àÒëÆ÷°ÑËüµ±³É double ±¨´í)
  504   1          eL = (float)(target_speed_L - left_encoder_data * 0.003518f);
  505   1          eR = (float)(target_speed_R - right_encoder_data * 0.003518f);
  506   1      
  507   1          ff_L = target_speed_L * KF_L;
  508   1          ff_R = target_speed_R * KF_R;
  509   1      
  510   1          // 3. Î»ÖÃÊ½ PD ¹«Ê½
  511   1          duty_L = Kp_L * eL + Kd_L * (eL - prev_e_L) + ff_L;
  512   1          duty_R = Kp_R * eR + Kd_R * (eR - prev_e_R) + ff_R;
  513   1      
  514   1          // È«¾ÖÏÞ·ù
  515   1          if (duty_L > MAX_DUTY)  duty_L = MAX_DUTY;
  516   1          if (duty_L < -MAX_DUTY) duty_L = -MAX_DUTY;
  517   1          if (duty_R > MAX_DUTY)  duty_R = MAX_DUTY;
