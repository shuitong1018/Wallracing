    7              // 方向引脚初始化 - gpio_init需要4个参数
    8              gpio_init(IO_P21, GPO, 1, GPO_PUSH_PULL);   // 左电机方向，初始高电平，推挽输出
    9              gpio_init(IO_P23, GPO, 1, GPO_PUSH_PULL);   // 右电机方向，初始高电平，推挽输出
   10              
   11              // PWM初始化 - 使用正确的PWM通道枚举
   12              // 左电机使用PWMA_CH1P_P20 (P20输出PWM)
   13              pwm_init(PWMA_CH1P_P20, 20000, 0);  // 20kHz，初始占空比0
   14              
   15              // 右电机使用PWMA_CH2P_P22 (P22输出PWM)
   16              pwm_init(PWMA_CH2P_P22, 20000, 0);  // 20kHz，初始占空比0
   17              encoder_dir_init(ENCODER_R, ENCODER_DIR_R, ENCODER_COUNT_R);          // 初始化右电机编码器，指定方向引脚和
