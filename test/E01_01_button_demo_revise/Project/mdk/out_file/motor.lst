   27            
   28          }
   29          
   30          void Motor_SetLeft(int speed)
   31          {
   32              uint8 dir = 1;
   33              uint32 pwm_value;
   34              
   35              // 速度限幅 (PWM范围0-10000，因为PWM_DUTY_MAX=10000)
   36              if(speed > MOTOR_SPEED_MAX) speed = MOTOR_SPEED_MAX;
   37              if(speed < -MOTOR_SPEED_MAX) speed = -MOTOR_SPEED_MAX;
   38              
   39              // 方向处理
   40              if(speed >= 0) {
   41                  dir = 1;                        // 正转
   42                  // 将0-255的速度映射到0-10000
   43                  pwm_value = (uint32)speed * (PWM_DUTY_MAX / MOTOR_SPEED_MAX);
   44              } else {
   45                  dir = 0;                        // 反转
   46                  pwm_value = (uint32)(-speed) * (PWM_DUTY_MAX / MOTOR_SPEED_MAX);
   47              }
   48              
   49              gpio_set_level(IO_P21, dir);                 // 设置方向
   50              pwm_set_duty(PWMA_CH1P_P20, pwm_value);      // 设置PWM占空比
   51          }
