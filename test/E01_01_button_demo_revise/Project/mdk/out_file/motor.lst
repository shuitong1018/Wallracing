   18              encoder_dir_init(ENCODER_L, ENCODER_DIR_L, ENCODER_COUNT_L);          // 初始化左电机编码器，指定方向引脚和
             -计数引脚
   19                  
   20              pwm_set_freq(PWM_R, 500, 5000);                       // 设置右电机 PWM 频率为 500 Hz，占空比为 50%（5000 对应 50
