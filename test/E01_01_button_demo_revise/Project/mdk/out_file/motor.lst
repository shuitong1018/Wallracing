   22                  
   23              system_delay_ms(3000);                            // 延迟 3000 ms，等待驱动板完成零点校准
   24                  
   25              pwm_set_freq(PWM_R, 1000, 0);                         // 恢复右电机 PWM 频率为 1000 Hz，占空比为 0，准备进入正常控
             -制
   26              pwm_set_freq(PWM_L, 1000, 0);                         // 恢复左电机 PWM 频率为 1000 Hz，占空比为 0，准备进入正常控
